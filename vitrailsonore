<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Vitrail Sonore Mobile V2</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --neon-blue: #00f7ff;
            --neon-blue-dim: #005a5e;
            --dark-metal: #1a1a1a;
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent; /* Enlève le flash gris au tap sur mobile */
        }

        body {
            background-color: #000;
            color: #ddd;
            margin: 0;
            height: 100vh;
            width: 100vw;
            display: flex;
            flex-direction: column;
            font-family: 'Cinzel', serif;
            overflow: hidden; /* Empêche le scroll global */
            touch-action: none; /* Bloque les gestes natifs (zoom/pan) pour toute l'app */
        }

        /* --- ZONE HAUTE : LE VITRAIL --- */
        #main-container {
            flex: 1; /* Prend tout l'espace disponible */
            display: flex;
            flex-direction: column;
            position: relative;
            background: radial-gradient(circle at center, #222 0%, #000 100%);
        }

        #stage-area {
            flex: 1;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* La boîte lumineuse (Zone active) */
        #lightbox {
            width: 85vmin; /* Responsive carré */
            height: 85vmin;
            border: 2px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.03);
            box-shadow: 0 0 30px rgba(0,0,0,0.8);
            position: relative;
            z-index: 0; /* Derrière les shards */
        }

        #lightbox::after {
            content: 'ZONE SONORE';
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            color: rgba(255,255,255,0.1);
            font-size: 2rem;
            pointer-events: none;
        }

        /* Zone de rangement (Palette) */
        #palette-area {
            height: 80px;
            background: #111;
            border-top: 1px solid #333;
            position: relative;
            z-index: 10;
        }

        /* --- LES PIÈCES (SHARDS) --- */
        .shard {
            position: absolute;
            z-index: 100; /* Toujours au dessus */
            /* touch-action: none est CRUCIAL pour que le drag fonctionne bien sur Android/iOS */
            touch-action: none; 
            cursor: grab;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
            transition: transform 0.1s;
        }

        .shard.active-shard {
            filter: drop-shadow(0 0 15px currentColor);
            z-index: 200;
        }

        /* --- ZONE BASSE : CONTRÔLES --- */
        #controls-area {
            height: auto;
            min-height: 140px;
            background: #080808;
            border-top: 2px solid #333;
            padding: 10px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-around;
            align-items: center;
            z-index: 300; /* Au dessus de tout */
        }

        /* Bouton Power */
        #power-btn {
            width: 70px; height: 70px;
            border-radius: 50%;
            background: #222;
            border: 2px solid #555;
            color: #555;
            font-weight: bold;
            display: flex; justify-content: center; align-items: center;
            font-size: 0.8rem;
            cursor: pointer;
            box-shadow: inset 0 0 10px #000;
            transition: all 0.3s;
        }
        #power-btn.is-on {
            background: #000;
            border-color: var(--neon-blue);
            color: var(--neon-blue);
            box-shadow: 0 0 20px var(--neon-blue);
            text-shadow: 0 0 5px var(--neon-blue);
        }

        /* Sliders */
        .slider-group {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin: 5px;
            width: 30%; /* 3 sliders par ligne approx */
        }
        .slider-label {
            font-size: 0.7rem;
            margin-bottom: 5px;
            color: #aaa;
        }
        input[type=range] {
            width: 100%;
            height: 20px; /* Plus haut pour le doigt */
            accent-color: var(--neon-blue);
        }

        #reset-btn {
            background: #333;
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 4px;
            font-family: 'Cinzel', serif;
            margin-top: 5px;
        }

    </style>
</head>
<body>

    <div id="main-container">
        <div id="stage-area">
            <div id="lightbox"></div>
        </div>
        <div id="palette-area"></div>
    </div>

    <div id="controls-area">
        <div id="power-btn">OFF</div>
        
        <div class="slider-group">
            <label class="slider-label">Volume</label>
            <input type="range" id="master-vol" min="0" max="1" step="0.01" value="0.5">
        </div>
        
        <div class="slider-group">
            <label class="slider-label">Tune</label>
            <input type="range" id="tuning" min="0.5" max="2.0" step="0.01" value="1.0">
        </div>
        
        <div class="slider-group">
            <label class="slider-label">Filtre</label>
            <input type="range" id="lpf" min="100" max="10000" step="10" value="5000">
        </div>

        <button id="reset-btn">Ranger</button>
    </div>

    <script>
        // --- AUDIO ENGINE ---
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        let audioCtx;
        let masterGain, lpf, compressor;
        let isAudioOn = false;

        // Elements DOM
        const powerBtn = document.getElementById('power-btn');
        const volSlider = document.getElementById('master-vol');
        const tuneSlider = document.getElementById('tuning');
        const lpfSlider = document.getElementById('lpf');
        const resetBtn = document.getElementById('reset-btn');
        const palette = document.getElementById('palette-area');
        const lightbox = document.getElementById('lightbox');

        const shards = [];
        const colors = [
            { c: 'cyan', type: 'square' },
            { c: 'lime', type: 'sine' },
            { c: 'yellow', type: 'triangle' },
            { c: 'magenta', type: 'sawtooth' }
        ];

        // 1. Initialisation Audio
        async function initAudio() {
            if(audioCtx) return;
            audioCtx = new AudioContext();
            
            masterGain = audioCtx.createGain();
            masterGain.gain.value = parseFloat(volSlider.value);
            
            lpf = audioCtx.createBiquadFilter();
            lpf.type = 'lowpass';
            lpf.frequency.value = parseFloat(lpfSlider.value);

            compressor = audioCtx.createDynamicsCompressor();

            // Chain: Master -> LPF -> Compressor -> Out
            masterGain.connect(lpf);
            lpf.connect(compressor);
            compressor.connect(audioCtx.destination);
        }

        // 2. Gestion des Boutons / Sliders (Events standards)
        powerBtn.addEventListener('click', async () => {
            if(!audioCtx) await initAudio();
            
            if(audioCtx.state === 'suspended') {
                await audioCtx.resume();
                isAudioOn = true;
                powerBtn.textContent = "ON";
                powerBtn.classList.add('is-on');
            } else {
                await audioCtx.suspend();
                isAudioOn = false;
                powerBtn.textContent = "OFF";
                powerBtn.classList.remove('is-on');
            }
        });

        // Mise à jour audio en temps réel
        volSlider.addEventListener('input', e => {
            if(masterGain) masterGain.gain.setTargetAtTime(parseFloat(e.target.value), audioCtx.currentTime, 0.05);
        });
        lpfSlider.addEventListener('input', e => {
            if(lpf) lpf.frequency.setTargetAtTime(parseFloat(e.target.value), audioCtx.currentTime, 0.05);
        });
        
        resetBtn.addEventListener('click', () => {
            shards.forEach(s => s.resetPosition());
        });

        // 3. CLASSE PIÈCE DE VERRE (SHARD)
        class Shard {
            constructor(config) {
                this.config = config;
                this.el = document.createElement('div');
                this.osc = null;
                this.gain = null;
                this.isPlaying = false;
                
                // Création Visuelle
                this.width = 50 + Math.random() * 30;
                this.height = 50 + Math.random() * 30;
                this.el.classList.add('shard');
                this.el.style.width = this.width + 'px';
                this.el.style.height = this.height + 'px';
                this.el.style.background = config.c;
                
                // Forme aléatoire CSS clip-path
                const p = [];
                for(let i=0; i<4; i++) {
                    p.push(`${Math.random()*100}% ${Math.random()*100}%`);
                }
                this.el.style.clipPath = `polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)`; // Forme simple rect pour faciliter le touch
                this.el.style.clipPath = `polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%)`; // Losange
                
                document.body.appendChild(this.el);
                
                this.resetPosition(true);
                this.initInteraction();
            }

            resetPosition(firstTime) {
                // On met dans la palette (en bas)
                const r = palette.getBoundingClientRect();
                const x = r.left + Math.random() * (r.width - this.width);
                const y = r.top + Math.random() * (r.height - this.height);
                this.el.style.left = x + 'px';
                this.el.style.top = y + 'px';
                this.stop();
            }

            // --- AUDIO LOGIC ---
            start() {
                if(this.isPlaying || !isAudioOn) return;
                this.osc = audioCtx.createOscillator();
                this.osc.type = this.config.type;
                this.gain = audioCtx.createGain();
                this.gain.gain.value = 0;
                
                this.osc.connect(this.gain);
                this.gain.connect(masterGain);
                this.osc.start();
                this.isPlaying = true;
                this.el.classList.add('active-shard');
            }

            update(rx, ry) {
                if(!this.isPlaying) return;
                const now = audioCtx.currentTime;
                // X = Freq (200Hz - 800Hz) * Tune
                const tune = parseFloat(tuneSlider.value);
                const freq = (200 + rx * 600) * tune;
                this.osc.frequency.setTargetAtTime(freq, now, 0.1);
                
                // Y = Volume
                this.gain.gain.setTargetAtTime(ry, now, 0.1);
            }

            stop() {
                if(!this.isPlaying) return;
                const g = this.gain;
                const o = this.osc;
                g.gain.setTargetAtTime(0, audioCtx.currentTime, 0.1);
                setTimeout(() => { o.stop(); o.disconnect(); g.disconnect(); }, 200);
                this.isPlaying = false;
                this.el.classList.remove('active-shard');
            }

            // --- INTERACTION TACTILE & SOURIS ---
            initInteraction() {
                let isDragging = false;
                let offset = { x: 0, y: 0 };

                // Fonction universelle de début
                const onStart = (clientX, clientY) => {
                    isDragging = true;
                    const rect = this.el.getBoundingClientRect();
                    offset.x = clientX - rect.left;
                    offset.y = clientY - rect.top;
                    this.el.style.zIndex = 1000; // Au premier plan
                };

                // Fonction universelle de mouvement
                const onMove = (clientX, clientY) => {
                    if(!isDragging) return;
                    
                    // Positionner l'élément
                    const newX = clientX - offset.x;
                    const newY = clientY - offset.y;
                    this.el.style.left = newX + 'px';
                    this.el.style.top = newY + 'px';

                    // Vérifier si on est dans la Lightbox
                    const box = lightbox.getBoundingClientRect();
                    const center = { x: newX + this.width/2, y: newY + this.height/2 };
                    
                    const inside = (
                        center.x > box.left && 
                        center.x < box.right && 
                        center.y > box.top && 
                        center.y < box.bottom
                    );

                    if(inside && isAudioOn) {
                        if(!this.isPlaying) this.start();
                        // Calculs normalisés (0.0 à 1.0)
                        const rx = (center.x - box.left) / box.width;
                        const ry = 1 - ((center.y - box.top) / box.height); // Y inversé (haut = fort)
                        this.update(rx, Math.max(0, Math.min(1, ry)));
                    } else {
                        this.stop();
                    }
                };

                const onEnd = () => {
                    isDragging = false;
                    this.el.style.zIndex = '';
                    // Si on relâche hors de la zone et que le son joue, on coupe
                    if(this.isPlaying) {
                        // Optionnel : on pourrait laisser jouer ou couper. Ici on coupe.
                        this.stop(); 
                    }
                };

                // --- Écouteurs SOURIS ---
                this.el.addEventListener('mousedown', e => {
                    if(e.button !== 0) return;
                    onStart(e.clientX, e.clientY);
                });
                window.addEventListener('mousemove', e => {
                    if(isDragging) {
                        e.preventDefault(); // Empêche sélection texte
                        onMove(e.clientX, e.clientY);
                    }
                });
                window.addEventListener('mouseup', onEnd);

                // --- Écouteurs TACTILES (Mobile) ---
                // passive: false est OBLIGATOIRE pour preventDefault()
                this.el.addEventListener('touchstart', e => {
                    e.preventDefault(); // Empêche le scroll quand on touche une pièce
                    const t = e.touches[0];
                    onStart(t.clientX, t.clientY);
                }, { passive: false });

                window.addEventListener('touchmove', e => {
                    if(isDragging) {
                        e.preventDefault(); // Empêche le scroll de la page PENDANT le drag
                        const t = e.touches[0];
                        onMove(t.clientX, t.clientY);
                    }
                }, { passive: false });

                window.addEventListener('touchend', onEnd);
            }
        }

        // Démarrage
        window.onload = () => {
            // Créer 2 pièces de chaque couleur
            colors.forEach(c => {
                shards.push(new Shard(c));
                shards.push(new Shard(c));
            });
        };

    </script>
</body>
</html>
